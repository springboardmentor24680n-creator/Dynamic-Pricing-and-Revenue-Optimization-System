# PricePilot AI - Backend Environment Template
# Copy to .env and fill in your values.

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dynamic_pricing
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=pricepilot_ai

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=60

# ---- CORS ----
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

# ---- Email (SMTP) ----
# Used to notify users when their access request is approved or rejected.
# Leave SMTP_HOST empty to disable email (notifications are logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=PricePilot AI <noreply@pricepilot.ai>
SMTP_USE_TLS=true
